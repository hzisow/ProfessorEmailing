# ===========================================================================
# ProfPing environment variables
# Copy this file to .env.local and fill in the values you have.
# ===========================================================================

# --- Anthropic (REQUIRED for scraping + hook generation) -------------------
# Get a key at https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=

# --- Google OAuth / Gmail API (REQUIRED for sending) -----------------------
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud Console,
# enable the Gmail API, and add yourself as a test user. See README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URI on the OAuth client.
# Local dev:  http://localhost:3000/api/auth/callback
# Production: https://YOUR-APP.vercel.app/api/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Obtained by visiting /api/auth once and copying the token off the result page.
GMAIL_REFRESH_TOKEN=

# The Gmail address you send from (the account you authorized above).
SENDER_EMAIL=hzisow@gmail.com

# --- Email verification (OPTIONAL) -----------------------------------------
# Free key from https://maileroo.com/ . If omitted, verification falls back to
# a local RFC-syntax check + DNS MX lookup (no SMTP/catch-all signals).
MAILEROO_API_KEY=

# --- Scraping fallbacks (BOTH OPTIONAL) ------------------------------------
# When a plain server-side fetch is blocked or returns too little text, the app
# automatically falls back to Jina AI Reader (https://r.jina.ai) — FREE, no key
# required, renders JavaScript. Set JINA_API_KEY only to raise rate limits
# (free key at https://jina.ai/reader/).
JINA_API_KEY=

# ScrapingBee is an extra paid fallback, tried only if a key is set
# (https://www.scrapingbee.com/). Not required — Jina covers most cases free.
SCRAPINGBEE_API_KEY=
